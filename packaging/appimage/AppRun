set -eu

appdir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

export APPDIR="$appdir"
export PATH="$appdir/usr/bin${PATH:+:$PATH}"
export LD_LIBRARY_PATH="$appdir/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export QT_PLUGIN_PATH="$appdir/usr/plugins"
export QT_QPA_PLATFORM_PLUGIN_PATH="$appdir/usr/plugins/platforms"

# AppRun identifies a GitHub AppImage payload so tipsy can use OfficialVerified
# with the compiled Roblox signer floor. Cryptographic AppImage admission stays
# in release CI (cosign). Source builds never receive this handoff.
if [ -n "${APPIMAGE:-}" ]; then
	case "$APPIMAGE" in
		/*)
			export TIPSY_RELEASE_ARTIFACT="$APPIMAGE"
			export TIPSY_RELEASE_APPDIR="$appdir"
			;;
	esac
fi

usage() {
	cat <<'USAGE'
Usage: Tipsy.AppImage [--play|--settings] [--no-integrate] [arguments...]

  --play          Launch the official Roblox client and skip the Tipsy menu
  --settings      Open the Tipsy setup and settings window
  --no-integrate  Do not write user desktop entries for dock/taskbar pinning

A Roblox website or protocol URI (roblox-player:, roblox://, or
https://www.roblox.com/games/...) launches the official client with that
experience. Running with no mode flag plays if a client is installed, and
opens settings so first-run setup can complete otherwise.
USAGE
}

# Desktop integration is owned by `tipsy desktop` (internal/desktop): it
# writes user-scope launcher entries for this AppImage under the identity of
# the build's release channel (Tipsy, or Tipsy-Dev for developer builds) and
# never shadows a Flatpak or distro package that already provides that
# identity. `tipsy desktop status` explains the result; `tipsy desktop adopt`
# without --if-unowned is the explicit takeover.
integrate_pin_entries() {
	[ -n "${APPIMAGE:-}" ] || return 0
	case "$APPIMAGE" in
		/*) ;;
		*) return 0 ;;
	esac
	[ -x "$appdir/usr/bin/tipsy" ] || return 0
	"$appdir/usr/bin/tipsy" desktop adopt --if-unowned \
		--appimage "$APPIMAGE" --icon "$appdir/tipsy.png" >/dev/null 2>&1 || true
}

runtime_is_ready() {
	if [ -n "${XDG_DATA_HOME:-}" ]; then
		data_home=$XDG_DATA_HOME
	else
		data_home="${HOME}/.local/share"
	fi
	[ -d "${data_home}/tipsy/runtime/lib/x86_64" ]
}

mode=
cli_launch=
integrate=1
invoked=$(basename -- "${ARGV0:-}")
case "$invoked" in
	*Settings*|*settings*)
		mode=settings
		;;
	*)
		mode=play
		;;
esac

while [ $# -gt 0 ]; do
	case "$1" in
		-h|--help)
			usage
			exit 0
			;;
		--play)
			mode=play
			cli_launch=
			shift
			;;
		--settings)
			mode=settings
			cli_launch=
			shift
			;;
		launch)
			mode=play
			cli_launch=1
			shift
			;;
		--no-integrate)
			integrate=0
			shift
			;;
		--)
			shift
			break
			;;
		*)
			case "$1" in
				roblox-player:*|roblox:*|https://www.roblox.com/*|https://web.roblox.com/*|https://roblox.com/*)
					mode=play
					;;
			esac
			break
			;;
	esac
done

if [ "$integrate" -eq 1 ]; then
	(integrate_pin_entries) || true
fi

if [ -n "$cli_launch" ]; then
	exec "$appdir/usr/bin/tipsy" launch "$@"
fi

gui="$appdir/usr/bin/tipsy-gui"
require_gui() {
	if [ ! -x "$gui" ]; then
		printf '%s\n' 'Tipsy: bundled graphical launcher is unavailable.' >&2
		exit 1
	fi
}

require_gui

if [ "$mode" = settings ]; then
	exec "$gui" "$@"
fi

if runtime_is_ready; then
	exec "$gui" --play "$@"
fi

exec "$gui" "$@"
